# Weather Underground upload keys.
#
# Install to /etc/pws/secrets.env with mode 600 (or 400) — wu-upload.sh
# refuses to run if the file is more permissive than that.
#
#   sudo install -m 600 secrets.env.example /etc/pws/secrets.env
#
# One entry per station. The variable name is WU_UPLOAD_KEY_ followed by the
# station ID exactly as it appears in $STATION_ID.
#
# Find the key in Weather Underground under My Profile -> My Devices ->
# your station -> "Upload Key". It is not your account password.

WU_UPLOAD_KEY_KCACLEAR4=replace-with-your-upload-key
